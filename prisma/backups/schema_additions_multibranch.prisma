/**
 * PRISMA SCHEMA ADDITIONS FOR MULTI-BRANCH ARCHITECTURE
 * 
 * Add these models to your prisma/schema.prisma file.
 * Insert them after the VariantOption model (around line 121)
 */

// ============================================================================
// SUCURSALES (Multi-Branch Support)
// ============================================================================
model Sucursal {
  id              Int      @id @default(autoincrement())
  name            String
  code            String   @unique
  
  // Location
  address         String
  city            String
  state           String
  country         String   @default("Argentina")
  postalCode      String?
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  
  // Contact
  phone           String
  email           String?
  whatsapp        String?
  
  // Social Media
  facebook        String?
  instagram       String?
  twitter         String?
  
  // Operating Hours (JSON)
  operatingHours  Json
  
  // Status
  isActive        Boolean  @default(true)
  isHeadquarters  Boolean  @default(false)
  
  // Relations
  administrators  UserSucursal[]
  employees       User[]
  inventory       BranchInventory[]
  sales           Sale[]
  transfersOut    Transfer[]     @relation("TransferOrigin")
  transfersIn     Transfer[]     @relation("TransferDestination")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ============================================================================
// BRANCH INVENTORY (Catalog-Inventory Separation)
// Single Source of Truth for Stock & Pricing per Branch
// ============================================================================
model BranchInventory {
  id              Int       @id @default(autoincrement())
  
  // Relations
  skuId           Int
  sku             SKU       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  
  sucursalId      Int
  sucursal        Sucursal  @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  
  // ÚNICA FUENTE DE VERDAD para stock y precio
  stock           Int       @default(0)
  price           Decimal   @db.Decimal(10, 2)
  soldQuantity    Int       @default(0)
  
  // Availability
  isActive        Boolean   @default(true)
  
  // Pricing & Thresholds
  costPrice       Decimal?  @db.Decimal(10, 2)
  minStock        Int       @ default(0)
  maxStock        Int?
  
  // Relations
  reservations    StockReservation[]
  saleItems       SaleItem[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Constraints
  @@unique([skuId, sucursalId])
  @@index([sucursalId])
  @@index([skuId])
  @@index([sucursalId, isActive])
}

// ============================================================================
// USER-SUCURSAL (Many-to-Many for Admins)
// ============================================================================
model UserSucursal {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sucursalId   Int
  sucursal     Sucursal  @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  
  assignedAt   DateTime  @default(now())
  assignedBy   Int?
  
  @@unique([userId, sucursalId])
  @@index([userId])
  @@index([sucursalId])
}

// ============================================================================
// TRANSFER & TRANSFER ITEM (Inter-Branch Transfers)
// ============================================================================
model Transfer {
  id                    Int            @id @default(autoincrement())
  
  // Branch to branch
  originSucursalId      Int
  originSucursal        Sucursal       @relation("TransferOrigin", fields: [originSucursalId], references: [id])
  
  destinationSucursalId Int
  destinationSucursal   Sucursal       @relation("TransferDestination", fields: [destinationSucursalId], references: [id])
  
  // User
  userId                Int
  user                  User           @relation(fields: [userId], references: [id])
  
  // Items & Status
  items                 TransferItem[]
  status                TransferStatus @default(PENDIENTE)
  notes                 String?        @db.Text
  
  // Legacy fields (if needed for backward compatibility)
  amount                Decimal?       @db.Decimal(10, 2)
  imageUrl              String?
  
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  
  @@index([originSucursalId])
  @@index([destinationSucursalId])
  @@index([userId])
}

model TransferItem {
  id            Int       @id @default(autoincrement())
  
  transferId    Int
  transfer      Transfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  
  skuId         Int
  sku           SKU       @relation(fields: [skuId], references: [id])
  
  quantity      Int
  
  @@index([transferId])
  @@index([skuId])
}

