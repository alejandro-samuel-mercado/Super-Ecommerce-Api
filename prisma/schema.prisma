generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  description String?
  parentId    Int?
  slug        String     @unique
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
}

model Product {
  name            String
  images          String[]
  qr              String?        @unique
  categoryId      Int
  updatedAt       DateTime       @updatedAt
  isActive        Boolean        @default(true)
  allowFractional Boolean        @default(false)
  basePrice       Decimal        @db.Decimal(10, 2)
  brand           String
  condition       ItemCondition  @default(NEW)
  createdAt       DateTime       @default(now())
  description     String
  id              Int            @id @default(autoincrement())
  isNew           Boolean        @default(false)
  isRecommended   Boolean        @default(false)
  isTrending      Boolean        @default(false)
  measurementUnit String         @default("UNIDAD")
  model           String?
  pointsReward    Int            @default(0)
  pointsValue     Int            @default(0)
  type            String
  visibleFrom     DateTime?
  visibleTo       DateTime?
  isDeleted       Boolean        @default(false)
  characteristics Json?
  specifications  Json?
  comments        Comment[]
  category        Category       @relation(fields: [categoryId], references: [id])
  productPrices   ProductPrice[]
  skus            SKU[]
  favoritedBy     User[]         @relation("UserFavorites")
}

model SKU {
  stock           Decimal             @default(0) @db.Decimal(10, 3)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  active          Boolean             @default(true)
  barcode         String?             @unique
  barcodeType     BarcodeType?        @default(INTERNO)
  code            String              @unique
  id              Int                 @id @default(autoincrement())
  isAutoGenerated Boolean             @default(false)
  price           Decimal             @db.Decimal(10, 2)
  productId       Int
  soldQuantity    Decimal             @default(0) @db.Decimal(10, 3)
  isDeleted       Boolean             @default(false)
  branchInventory BranchInventory[]
  cartItems       CartItem[]
  purchaseItems   PurchaseItem[]
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems       SaleItem[]
  stockMovements  StockMovement[]
  reservations    StockReservation[]
  transferItems   StockTransferItem[]
  supplierSkus    SupplierSKU[]
  variantOptions  VariantOption[]

  @@index([productId])
  @@index([barcode])
}

model BarcodeSequence {
  id           Int      @id @default(autoincrement())
  prefix       String   @default("779999")
  lastSequence Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model VariantOption {
  id    Int    @id @default(autoincrement())
  skuId Int
  name  String
  value String
  sku   SKU    @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([skuId, name])
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  users       User[]
  permissions Permission[] @relation("RolePermissions")
}

model Permission {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  description String?
  roles       Role[]  @relation("RolePermissions")
  users       User[]  @relation("UserPermissions")
}

model User {
  id               Int                @id @default(autoincrement())
  name             String
  email            String             @unique
  password         String
  roleId           Int
  dni              String?
  updatedAt        DateTime           @updatedAt
  activeBranchId   Int?
  address          String?
  branchId         Int?
  city             String?
  country          String?
  createdAt        DateTime           @default(now())
  dniVerified      Boolean            @default(false)
  lastLogin        DateTime?
  phone            String?
  points           Int                @default(0)
  profileImage     String?
  state            String?
  status           UserStatus         @default(PENDING_VERIFICATION)
  zipCode          String?
  resetCode        String?
  resetCodeExpires DateTime?
  emailVerified    Boolean            @default(false)
  verificationCode String?
  accessLogs       AccessLog[]
  auditLogs        AuditLog[]         @relation("AdminActions")
  cart             Cart?
  conversations    ChatConversation[]
  comments         Comment[]
  notifications    Notification[]
  pointsHistory    PointsHistory[]
  purchases        Purchase[]
  refreshTokens    RefreshToken[]
  managedSales     Sale[]             @relation("EmployeeSales")
  sales            Sale[]             @relation("CustomerSales")
  stockTransfers   StockTransfer[]
  transfers        Transfer[]
  branch           Branch?            @relation(fields: [branchId], references: [id])
  role             Role               @relation(fields: [roleId], references: [id])
  adminBranches    UserBranch[]
  favorites        Product[]          @relation("UserFavorites")
  permissions      Permission[]       @relation("UserPermissions")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id       Int     @id @default(autoincrement())
  cartId   Int
  skuId    Int
  quantity Decimal @db.Decimal(10, 3)
  cart     Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku      SKU     @relation(fields: [skuId], references: [id])

  @@unique([cartId, skuId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
  branchId  Int?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@index([branchId])
}

model RefreshToken {
  id          String   @id @default(uuid())
  hashedToken String
  userId      Int
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PointsHistory {
  id        Int       @id @default(autoincrement())
  userId    Int
  amount    Int
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  reason    String
  type      PointType
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Comment {
  id        Int      @id @default(autoincrement())
  userId    Int
  rating    Int?
  productId Int?
  approved  Boolean  @default(false)
  content   String
  createdAt DateTime @default(now())
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sale {
  id                     Int                  @id @default(autoincrement())
  uuid                   String               @unique @default(uuid())
  userId                 Int
  employeeId             Int?
  couponId               Int?
  total                  Decimal              @db.Decimal(10, 2)
  subtotal               Decimal              @db.Decimal(10, 2)
  discount               Decimal              @default(0) @db.Decimal(10, 2)
  shippingCost           Decimal              @default(0) @db.Decimal(10, 2)
  appliedDiscounts       Json?
  paymentStatus          PaymentStatus        @default(PENDING)
  paymentType            PaymentType          @default(CASH)
  deliveryType           DeliveryType         @default(PICKUP)
  deliveryStatus         DeliveryStatus       @default(PENDING_DELIVERY)
  deliveryAddress        String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  branchId               Int
  mpPaymentId            String?
  observations           String?
  pointsDiscount         Decimal              @default(0) @db.Decimal(10, 2)
  pointsUsed             Int                  @default(0)
  taxAmount              Decimal              @default(0) @db.Decimal(10, 2)
  currencyCode           String?              @default("ARS")
  exchangeRateAtPurchase Decimal?             @default(1.0) @db.Decimal(18, 8)
  paymentGateway         String?
  totalInBaseCurrency    Decimal?             @db.Decimal(10, 2)
  paymentProofUploadedAt DateTime?
  paymentProofUrl        String?
  cancelReason           String?
  paymentTransactions    PaymentTransaction[]
  branch                 Branch               @relation(fields: [branchId], references: [id])
  coupon                 Coupon?              @relation(fields: [couponId], references: [id])
  currency               Currency?            @relation(fields: [currencyCode], references: [code])
  employee               User?                @relation("EmployeeSales", fields: [employeeId], references: [id])
  user                   User                 @relation("CustomerSales", fields: [userId], references: [id])
  items                  SaleItem[]
  receipt                SaleReceipt?
  stockReservations      StockReservation[]
}

model SaleItem {
  id                     Int              @id @default(autoincrement())
  saleId                 Int
  productName            String
  skuCode                String
  unitPrice              Decimal          @db.Decimal(10, 2)
  quantity               Decimal          @db.Decimal(10, 3)
  subtotal               Decimal          @db.Decimal(10, 2)
  skuId                  Int?
  branchInventoryId      Int?
  measurementUnit        String?          @default("UNIDAD")
  subtotalInBaseCurrency Decimal?         @db.Decimal(10, 2)
  unitCostBase           Decimal?         @db.Decimal(10, 2)
  branchInventory        BranchInventory? @relation(fields: [branchInventoryId], references: [id])
  sale                   Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  sku                    SKU?             @relation(fields: [skuId], references: [id])
}

model Coupon {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  type           String
  value          Decimal   @db.Decimal(10, 2)
  minPurchase    Decimal?  @db.Decimal(10, 2)
  maxDiscount    Decimal?  @db.Decimal(10, 2)
  validFrom      DateTime  @default(now())
  validUntil     DateTime?
  maxUses        Int?
  maxUsesPerUser Int?
  usedCount      Int       @default(0)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  sales          Sale[]
}

model PaymentTransaction {
  id             String                   @id @default(uuid())
  paymentId      String                   @unique
  saleId         Int
  status         PaymentTransactionStatus @default(PROCESSING)
  webhookPayload Json
  attempts       Int                      @default(0)
  processedAt    DateTime?
  createdAt      DateTime                 @default(now())
  sale           Sale                     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([paymentId])
}

model StockReservation {
  id                String           @id @default(uuid())
  skuId             Int
  branchInventoryId Int?
  saleId            Int
  quantity          Decimal          @db.Decimal(10, 3)
  expiresAt         DateTime
  released          Boolean          @default(false)
  createdAt         DateTime         @default(now())
  branchInventory   BranchInventory? @relation(fields: [branchInventoryId], references: [id], onDelete: Cascade)
  sale              Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  sku               SKU              @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@index([skuId, released])
  @@index([expiresAt, released])
}

model Event {
  id              Int        @id @default(autoincrement())
  name            String
  active          Boolean    @default(true)
  bannerMessages  Json?
  couponsEnabled  Boolean    @default(false)
  deliveryMethods Json?
  endDate         DateTime
  paymentMethods  Json?
  pointsEnabled   Boolean    @default(false)
  shippingConfig  Json?
  shippingEnabled Boolean    @default(true)
  startDate       DateTime
  taxesEnabled    Boolean    @default(true)
  heroBanners     Json?
  marqueeText     Json?
  secondaryAds    Json?
  discounts       Discount[]
}

model Discount {
  id         Int           @id @default(autoincrement())
  name       String
  type       DiscountType
  value      Decimal       @db.Decimal(10, 2)
  priority   Int           @default(0)
  scope      DiscountScope @default(GLOBAL)
  targetIds  Int[]
  mode       DiscountMode  @default(AUTOMATIC)
  active     Boolean       @default(true)
  eventId    Int?
  rules      Json?
  stackable  Boolean       @default(false)
  validFrom  DateTime?     @default(now())
  validUntil DateTime?
  event      Event?        @relation(fields: [eventId], references: [id])
}

model ShippingZone {
  id       Int     @id @default(autoincrement())
  country  String?
  province String?
  city     String?
  cost     Decimal @db.Decimal(10, 2)
  active   Boolean @default(true)

  @@unique([country, province, city])
}

model StoreConfig {
  id                     Int      @id @default(1)
  storeName              String   @default("Mi Tienda")
  contactEmail           String?
  contactPhone           String?
  address                String?
  taxRate                Decimal  @default(0) @db.Decimal(10, 2)
  currencySymbol         String   @default("$")
  lowStockThreshold      Int      @default(5)
  preventStockout        Boolean  @default(true)
  enablePoints           Boolean  @default(true)
  pointsPerCurrency      Decimal  @default(0.1) @db.Decimal(12, 4)
  enableShipping         Boolean  @default(true)
  freeShippingThreshold  Decimal? @db.Decimal(12, 4)
  webSafetyStock         Int      @default(0)
  enabledPaymentMethods  Json?
  enableEvents           Boolean  @default(true)
  enableBranches         Boolean  @default(true)
  enableTransfers        Boolean  @default(true)
  enableStockMovements   Boolean  @default(true)
  enableStockControl     Boolean  @default(true)
  enablePointsRedemption Boolean  @default(false)
  moneyPerPoint          Decimal  @default(1.0) @db.Decimal(12, 4)
  socialInstagram        String?
  socialFacebook         String?
  socialTwitter          String?
  maintenanceMode        Boolean  @default(false)
  logoUrl                String?
  adImage                String?
  adText                 String?
  openingHours           Json?
  customMeasurementUnits String[] @default([])
  updatedAt              DateTime @updatedAt
  baseCurrency           String   @default("ARS")
  criticalStockThreshold Int      @default(2)
  defaultCurrency        String   @default("ARS")
  backupFrequency        String   @default("WEEKLY")
  enableAutoBackup       Boolean  @default(false)
  marqueeText            Json?
  bannerImage            Json?
  secondaryAds           Json?
  country                String   @default("Argentina")
}

model Currency {
  id                 Int                      @id @default(autoincrement())
  code               String                   @unique
  symbol             String
  exchangeRateToBase Decimal                  @db.Decimal(18, 8)
  isActive           Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  gatewaySupport     GatewayCurrencySupport[]
  productPrices      ProductPrice[]
  purchases          Purchase[]
  sales              Sale[]
  saleReceipts       SaleReceipt[]
  supplierPayments   SupplierPayment[]
}

model ProductPrice {
  id           Int      @id @default(autoincrement())
  productId    Int
  currencyCode String
  price        Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  currency     Currency @relation(fields: [currencyCode], references: [code])
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, currencyCode])
}

model PaymentGateway {
  id                  Int                      @id @default(autoincrement())
  name                String
  slug                String                   @unique
  config              Json?
  isActive            Boolean                  @default(true)
  isGlobalFallback    Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  supportedCurrencies GatewayCurrencySupport[]
}

model GatewayCurrencySupport {
  id           Int            @id @default(autoincrement())
  gatewayId    Int
  currencyCode String
  isPrimary    Boolean        @default(false)
  currency     Currency       @relation(fields: [currencyCode], references: [code])
  gateway      PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)

  @@unique([gatewayId, currencyCode])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   String
  adminId    Int?
  changes    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  branchId   Int?
  admin      User?    @relation("AdminActions", fields: [adminId], references: [id])
  branch     Branch?  @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

model AccessLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transfer {
  id        Int            @id @default(autoincrement())
  userId    Int
  amount    Decimal        @db.Decimal(10, 2)
  imageUrl  String
  status    TransferStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  branchId  Int?
  branch    Branch?        @relation(fields: [branchId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
}

model Branch {
  id               Int               @id @default(autoincrement())
  name             String
  code             String            @unique
  address          String
  city             String
  state            String
  country          String            @default("Argentina")
  postalCode       String?
  latitude         Decimal?          @db.Decimal(10, 7)
  longitude        Decimal?          @db.Decimal(10, 7)
  phone            String
  email            String?
  whatsapp         String?
  facebook         String?
  instagram        String?
  twitter          String?
  operatingHours   Json
  isActive         Boolean           @default(true)
  isHeadquarters   Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lastTicketNumber Int               @default(0)
  auditLogs        AuditLog[]
  inventory        BranchInventory[]
  notifications    Notification[]
  purchases        Purchase[]
  sales            Sale[]
  receipts         SaleReceipt[]
  stockMovements   StockMovement[]
  transfersIn      StockTransfer[]   @relation("StockTransferDestination")
  transfersOut     StockTransfer[]   @relation("StockTransferOrigin")
  bankTransfers    Transfer[]
  employees        User[]
  administrators   UserBranch[]
}

model SaleReceipt {
  id           Int         @id @default(autoincrement())
  saleId       Int         @unique
  branchId     Int
  ticketNumber String
  subtotal     Decimal     @db.Decimal(10, 2)
  discount     Decimal     @db.Decimal(10, 2)
  total        Decimal     @db.Decimal(10, 2)
  paymentType  PaymentType
  status       String      @default("ISSUED")
  issuedBy     Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  currencyCode String?     @default("ARS")
  branch       Branch      @relation(fields: [branchId], references: [id])
  currency     Currency?   @relation(fields: [currencyCode], references: [code])
  sale         Sale        @relation(fields: [saleId], references: [id])

  @@unique([branchId, ticketNumber])
}

model BranchInventory {
  id           Int                @id @default(autoincrement())
  skuId        Int
  branchId     Int
  stock        Decimal            @default(0) @db.Decimal(10, 3)
  price        Decimal            @db.Decimal(10, 2)
  soldQuantity Decimal            @default(0) @db.Decimal(10, 3)
  isActive     Boolean            @default(true)
  costPrice    Decimal?           @db.Decimal(10, 2)
  minStock     Decimal            @default(0) @db.Decimal(10, 3)
  maxStock     Decimal?           @db.Decimal(10, 3)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sku          SKU                @relation(fields: [skuId], references: [id], onDelete: Cascade)
  saleItems    SaleItem[]
  reservations StockReservation[]

  @@unique([skuId, branchId])
  @@index([branchId])
  @@index([skuId])
  @@index([branchId, isActive])
}

model UserBranch {
  id         Int      @id @default(autoincrement())
  userId     Int
  branchId   Int
  assignedAt DateTime @default(now())
  assignedBy Int?
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

model StockTransfer {
  id                  Int                 @id @default(autoincrement())
  originBranchId      Int
  destinationBranchId Int
  userId              Int
  status              String              @default("PENDING")
  notes               String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  destinationBranch   Branch              @relation("StockTransferDestination", fields: [destinationBranchId], references: [id])
  originBranch        Branch              @relation("StockTransferOrigin", fields: [originBranchId], references: [id])
  user                User                @relation(fields: [userId], references: [id])
  items               StockTransferItem[]

  @@index([originBranchId])
  @@index([destinationBranchId])
  @@index([userId])
}

model StockTransferItem {
  id         Int           @id @default(autoincrement())
  transferId Int
  skuId      Int
  quantity   Decimal       @db.Decimal(10, 3)
  sku        SKU           @relation(fields: [skuId], references: [id])
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
}

model Supplier {
  id             Int               @id @default(autoincrement())
  tradeName      String
  legalName      String
  taxId          String            @unique
  taxStatus      String
  email          String
  phone          String
  billingAddress String
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  purchases      Purchase[]
  payments       SupplierPayment[]
  skus           SupplierSKU[]
}

model SupplierSKU {
  id                    Int      @id @default(autoincrement())
  supplierId            Int
  skuId                 Int
  supplierSkuCode       String?
  basePurchasePrice     Decimal  @db.Decimal(10, 2)
  currency              String   @default("ARS")
  estimatedDeliveryDays Int?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  sku                   SKU      @relation(fields: [skuId], references: [id])
  supplier              Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, skuId])
}

model Purchase {
  id                     Int              @id @default(autoincrement())
  branchId               Int
  supplierId             Int
  userId                 Int
  status                 PurchaseStatus   @default(DRAFT)
  estimatedTotal         Decimal          @default(0) @db.Decimal(10, 2)
  deliveryDate           DateTime?
  notes                  String?
  receivedAt             DateTime?
  receivedBy             Int?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  currencyCode           String?          @default("ARS")
  exchangeRateAtPurchase Decimal?         @default(1.0) @db.Decimal(18, 8)
  totalInBaseCurrency    Decimal?         @db.Decimal(10, 2)
  branch                 Branch           @relation(fields: [branchId], references: [id])
  currency               Currency?        @relation(fields: [currencyCode], references: [code])
  supplier               Supplier         @relation(fields: [supplierId], references: [id])
  user                   User             @relation(fields: [userId], references: [id])
  items                  PurchaseItem[]
  payment                SupplierPayment?
}

model PurchaseItem {
  id               Int      @id @default(autoincrement())
  purchaseId       Int
  skuId            Int
  quantity         Decimal  @db.Decimal(10, 3)
  unitPrice        Decimal  @db.Decimal(10, 2)
  subtotal         Decimal  @db.Decimal(10, 2)
  receivedQuantity Int?
  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  sku              SKU      @relation(fields: [skuId], references: [id])

  @@index([purchaseId])
  @@index([skuId])
}

model StockMovement {
  id             Int               @id @default(autoincrement())
  skuId          Int
  branchId       Int
  type           StockMovementType
  quantity       Decimal           @db.Decimal(10, 3)
  resultingStock Decimal           @db.Decimal(10, 3)
  referenceId    String?
  userId         Int?
  notes          String?
  createdAt      DateTime          @default(now())
  branch         Branch            @relation(fields: [branchId], references: [id])
  sku            SKU               @relation(fields: [skuId], references: [id])

  @@index([skuId, branchId])
  @@index([type])
  @@index([createdAt])
}

model SupplierPayment {
  id                     Int                   @id @default(autoincrement())
  supplierId             Int
  purchaseId             Int?                  @unique
  amount                 Decimal               @db.Decimal(10, 2)
  method                 SupplierPaymentMethod
  paymentDate            DateTime
  reference              String?
  createdBy              Int
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  amountInBaseCurrency   Decimal?              @db.Decimal(10, 2)
  currencyCode           String?               @default("ARS")
  exchangeRateAtPurchase Decimal?              @default(1.0) @db.Decimal(18, 8)
  currency               Currency?             @relation(fields: [currencyCode], references: [code])
  purchase               Purchase?             @relation(fields: [purchaseId], references: [id])
  supplier               Supplier              @relation(fields: [supplierId], references: [id])
}

model ChatConversation {
  id        Int           @id @default(autoincrement())
  userId    Int?
  socketId  String?
  closed    Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User?         @relation(fields: [userId], references: [id])
  messages  ChatMessage[]
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  sender         String
  content        String
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model ChatAutoResponse {
  id       Int     @id @default(autoincrement())
  trigger  String? @unique
  response String?
  isActive Boolean @default(true)
}

model ErrorLog {
  id          Int           @id @default(autoincrement())
  severity    ErrorSeverity @default(MEDIUM)
  code        String
  message     String
  stack       String?
  context     Json?
  status      ErrorStatus   @default(OPEN)
  occurrences Int           @default(1)
  resolvedBy  Int?
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

model BlogPost {
  id           Int       @id @default(autoincrement())
  slug         String    @unique
  title        String
  excerpt      String
  content      String
  coverImage   String?
  authorName   String    @default("Admin")
  authorAvatar String?
  authorBio    String?
  tags         String[]
  readingTime  Int       @default(5)
  published    Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([published])
  @@index([publishedAt])
}

