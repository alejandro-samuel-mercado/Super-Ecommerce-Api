generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum ItemCondition {
  NEW
  USED
  REFURBISHED
  EXHIBITION
}

// --------------------------------------------------------------------------
// CATEGORIA
// --------------------------------------------------------------------------
model Category {
  id          Int       @id @default(autoincrement())
  name        String    
  slug        String    @unique
  description String?
  
  
  parentId    Int?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// --------------------------------------------------------------------------
// PRODUCTO BASE
// Representa el concepto general. NO tiene stock directo.
// --------------------------------------------------------------------------
model Product {
  id              Int           @id @default(autoincrement())
  name            String
  type            String        // Ej: Ropa, Tecnología
  brand           String
  model           String?      
  description     String
  basePrice       Decimal       @db.Decimal(10, 2) 
  pointsValue     Int           @default(0)        
  pointsReward    Int           @default(0)        
  images          String[]      
  createdAt       DateTime      @default(now())
  
  condition       ItemCondition @default(NEW)
  qr              String?       @unique           

  // Flags de Visibilidad y Marketing (Stage 4)
  isTrending      Boolean       @default(false)
  isRecommended   Boolean       @default(false)
  isNew           Boolean       @default(false)
  isActive        Boolean       @default(true) 
  
  visibleFrom     DateTime?
  visibleTo       DateTime?

  // Unidades de Medida
  measurementUnit  String       @default("UNIDAD") // "UNIDAD", "KG", "METRO", "LITRO"
  allowFractional  Boolean      @default(false)    // Permite 1.5 kg, etc.

  // Relaciones
  category        Category      @relation(fields: [categoryId], references: [id])
  categoryId      Int

  skus            SKU[]
  productPrices   ProductPrice[]
  comments        Comment[]
  favoritedBy     User[]        @relation("UserFavorites")
  
  updatedAt       DateTime      @updatedAt
}

// --------------------------------------------------------------------------
// SKU (Stock Keeping Unit) - VARIANTE
// Es la unidad real que se vende. Maneja el stock y el precio final.
// Si un producto no tiene variantes, tendrá 1 SKU por defecto.
// --------------------------------------------------------------------------
model SKU {
  id              Int           @id @default(autoincrement())
  code            String        @unique //único (Ej: PROD1-ROJ-M)
  price           Decimal       @db.Decimal(10, 2) 
  stock           Decimal       @default(0) @db.Decimal(10, 3) 
  soldQuantity    Decimal       @default(0) @db.Decimal(10, 3)
  active          Boolean       @default(true) 
  
  // Barcode System
  barcode         String?       @unique
  barcodeType     BarcodeType?  @default(INTERNO)
  isAutoGenerated Boolean       @default(false)

  // Relaciones
  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       Int

  variantOptions  VariantOption[] 
  saleItems       SaleItem[]
  cartItems       CartItem[]
  reservations    StockReservation[] 
  
  
  branchInventory BranchInventory[]
  transferItems   StockTransferItem[]
  
  supplierSkus    SupplierSKU[]
  purchaseItems   PurchaseItem[]
  stockMovements  StockMovement[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([productId])
  @@index([barcode])
}

enum BarcodeType {
  EAN13
  INTERNO
}

model BarcodeSequence {
  id           Int      @id @default(autoincrement())
  prefix       String   @default("779999")
  lastSequence Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// --------------------------------------------------------------------------
// OPCIONES DE VARIANTE (Dynamic Attributes)
// Permite definir flexibilidad: Color, RAM, Talle, etc. sin alterar la tabla.
// --------------------------------------------------------------------------
model VariantOption {
  id              Int       @id @default(autoincrement())
  name            String    // Ej: "Color", "Almacenamiento", "Talle"
  value           String    // Ej: "Rojo", "64GB", "XL"
  
  sku             SKU       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  skuId           Int

  @@unique([skuId, name]) 
}

// --------------------------------------------------------------------------
// COMENTARIOS
// --------------------------------------------------------------------------
// --------------------------------------------------------------------------
// USUARIOS Y ROLES (RBAC)
// --------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique // 'SUPER_ADMIN', 'ADMIN', etc.
  description String?
  
  users       User[]
  permissions Permission[] @relation("RolePermissions")
}

model Permission {
  id          Int     @id @default(autoincrement())
  slug        String  @unique // 'create_product', 'delete_user'
  description String?

  roles       Role[]  @relation("RolePermissions")
  users       User[]  @relation("UserPermissions") // Permisos específicos por usuario
}

model User {
  id              Int        @id @default(autoincrement())
  name            String
  email           String     @unique
  password        String    
  profileImage    String?
  status          UserStatus @default(ACTIVE)
  
  // Role
  role            Role       @relation(fields: [roleId], references: [id])
  roleId          Int

  // Datos personales
  dni             String?
  dniVerified     Boolean    @default(false)
  phone           String?
  address         String?
  city            String?
  state           String?
  country         String?
  zipCode         String?

  // Puntos
  points          Int             @default(0)
  pointsHistory   PointsHistory[]

  // Seguridad
  lastLogin       DateTime?
  accessLogs      AccessLog[]
  auditLogs       AuditLog[]      @relation("AdminActions") 
  
  refreshTokens   RefreshToken[]
  
  // Relaciones
  comments        Comment[]
  permissions     Permission[]    @relation("UserPermissions") 
  sales           Sale[]          @relation("CustomerSales")
  managedSales    Sale[]          @relation("EmployeeSales") 
  favorites       Product[]       @relation("UserFavorites")
  transfers       Transfer[]
  stockTransfers  StockTransfer[]
  purchases       Purchase[]

  branchId        Int?
  branch          Branch?  @relation(fields: [branchId], references: [id])
  adminBranches   UserBranch[]
  activeBranchId  Int?
  conversations   ChatConversation[]

  notifications   Notification[]
  
  // Recuperación de Contraseña
  resetCode        String?
  resetCodeExpires DateTime?

  cart            Cart?
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  skuId     Int
  sku       SKU      @relation(fields: [skuId], references: [id])
  quantity  Decimal  @db.Decimal(10, 3)
  
  @@unique([cartId, skuId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // ORDER, PROMO, STOCK, POINTS, SYSTEM, ERROR
  title     String
  message   String
  read      Boolean  @default(false)
  data      Json?    
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([read])
}

model RefreshToken {
  id          String   @id @default(uuid())
  hashedToken String
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  expiresAt   DateTime // Rotación periódica
}

enum PointType {
  EARNED
  USED
  EXPIRED
}

model PointsHistory {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type            PointType
  amount          Int
  reason          String    
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
}

// --------------------------------------------------------------------------
// COMENTARIOS
// --------------------------------------------------------------------------
model Comment {
  id          Int      @id @default(autoincrement())
  userId      Int      // Relación real con User
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  content     String
  rating      Int?     // 1 al 5
  createdAt   DateTime @default(now())
  approved    Boolean  @default(false) // Moderación

  product     Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   Int?      
}

// --------------------------------------------------------------------------
// VENTAS Y CUPONES
// --------------------------------------------------------------------------

enum PaymentStatus {
  PENDING
  PAID
  CANCELLED
  REJECTED
}

enum PaymentType {
  CASH
  DEBIT
  CARD
  TRANSFER
  MERCADO_PAGO
  POINTS
}

enum DeliveryType {
  PICKUP
  DELIVERY
}

enum DeliveryStatus {
  PENDING_DELIVERY
  SHIPPED
  DELIVERED
  CANCELLED
  REQUIRES_ACTION
}

model Sale {
  id              Int            @id @default(autoincrement())
  uuid            String         @unique @default(uuid()) 
  
  userId          Int
  user            User           @relation("CustomerSales", fields: [userId], references: [id])
  
  employeeId      Int?
  employee        User?          @relation("EmployeeSales", fields: [employeeId], references: [id])

  branchId        Int
  branch          Branch         @relation(fields: [branchId], references: [id])


  couponId        Int?
  coupon          Coupon?        @relation(fields: [couponId], references: [id])

  total           Decimal        @db.Decimal(10, 2)
  subtotal        Decimal        @db.Decimal(10, 2)
  discount        Decimal        @default(0) @db.Decimal(10, 2)

  // Stage 3: Snapshot fields
  shippingCost     Decimal       @default(0) @db.Decimal(10, 2)
  taxAmount        Decimal       @default(0) @db.Decimal(10, 2) // Impuesto calculado
  appliedDiscounts Json?         

  paymentStatus   PaymentStatus  @default(PENDING)
  paymentType     PaymentType    @default(CASH)
  
  deliveryType    DeliveryType   @default(PICKUP)
  deliveryStatus  DeliveryStatus @default(PENDING_DELIVERY)
  deliveryAddress String?       
  observations    String?        @db.Text

  // Auditing Points Redemption
  pointsUsed      Int            @default(0)
  pointsDiscount  Decimal        @default(0) @db.Decimal(10, 2)
  
  // Payment Integration
  mpPaymentId     String?        

  currencyCode           String?       @default("ARS") 
  currency               Currency?     @relation(fields: [currencyCode], references: [code])
  exchangeRateAtPurchase Decimal?      @default(1.0) @db.Decimal(18, 8)
  totalInBaseCurrency    Decimal?      @db.Decimal(10, 2)
  
  paymentGateway         String?       

  items              SaleItem[]
  paymentTransactions PaymentTransaction[]
  stockReservations   StockReservation[]
  receipt             SaleReceipt?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model SaleItem {
  id              Int     @id @default(autoincrement())
  saleId          Int
  sale            Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  // Snapshot data (Inmutable)
  productName     String
  skuCode         String
  unitPrice       Decimal @db.Decimal(10, 2)
  
  quantity        Decimal @db.Decimal(10, 3) 
  subtotal        Decimal @db.Decimal(10, 2)
  subtotalInBaseCurrency Decimal? @db.Decimal(10, 2)
  unitCostBase    Decimal? @db.Decimal(10, 2)
  
  measurementUnit String? @default("UNIDAD") 
  
  skuId           Int?
  sku             SKU?    @relation(fields: [skuId], references: [id])

  branchInventoryId Int?
  branchInventory   BranchInventory? @relation(fields: [branchInventoryId], references: [id])
}

model Coupon {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  type        String // 'PERCENTAGE', 'FIXED'
  value       Decimal   @db.Decimal(10, 2)
  
  minPurchase Decimal?  @db.Decimal(10, 2)
  maxDiscount Decimal?  @db.Decimal(10, 2) // Tope de reintegro

  validFrom   DateTime  @default(now())
  validUntil  DateTime?
  
  maxUses     Int?     
  usedCount   Int       @default(0)
  
  active      Boolean   @default(true)
  sales       Sale[]
  createdAt   DateTime  @default(now())
}

// --------------------------------------------------------------------------
// PAYMENT TRANSACTIONS (Webhook Idempotency)
// --------------------------------------------------------------------------

enum PaymentTransactionStatus {
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
  FAILED_REFUND_ERROR
}

model PaymentTransaction {
  id              String   @id @default(uuid())
  paymentId       String   @unique 
  saleId          Int
  sale            Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  status          PaymentTransactionStatus @default(PROCESSING)
  webhookPayload  Json     
  attempts        Int      @default(0)
  processedAt     DateTime?
  
  createdAt       DateTime @default(now())
  
  @@index([saleId])
  @@index([paymentId])
}

// --------------------------------------------------------------------------
// STOCK RESERVATIONS (Temporary Holds for Pending Payments)
// --------------------------------------------------------------------------

model StockReservation {
  id         String   @id @default(uuid())
  skuId      Int
  sku        SKU      @relation(fields: [skuId], references: [id], onDelete: Cascade)
  
  branchInventoryId Int?
  branchInventory   BranchInventory? @relation(fields: [branchInventoryId], references: [id], onDelete: Cascade)
  
  saleId     Int
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  quantity   Decimal   @db.Decimal(10, 3) 
  expiresAt  DateTime 
  released   Boolean  @default(false) 
  
  createdAt  DateTime @default(now())
  
  @@index([skuId, released])
  @@index([expiresAt, released])
}

// --------------------------------------------------------------------------
// STAGE 3: DESCUENTOS Y ENVIOS
// --------------------------------------------------------------------------

enum DiscountScope {
  PRODUCT
  CATEGORY
  BRAND
  SKU
  GLOBAL
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED_PRICE
}

enum DiscountMode {
  AUTOMATIC
  MANUAL
}

model Event {
  id          Int      @id @default(autoincrement())
  name        String
  startDate   DateTime
  endDate     DateTime
  active      Boolean  @default(true)
  
  discounts   Discount[]

  // Advanced Event Configuration
  shippingConfig   Json?    // { type: 'FREE' | 'DISCOUNT', value: 0 }
  shippingEnabled  Boolean  @default(true)
  couponsEnabled   Boolean  @default(false)
  
  paymentMethods   Json?    // ['EFECTIVO', 'TARJETA']
  deliveryMethods  Json?    // ['LOCAL', 'DOMICILIO']
  
  pointsEnabled    Boolean  @default(false)
  taxesEnabled     Boolean  @default(true)
  
  bannerMessages   Json?    
  
  heroBanners      Json?    
  marqueeText      Json?    
  secondaryAds     Json?    
}

model Discount {
  id              Int           @id @default(autoincrement())
  name            String
  type            DiscountType
  value           Decimal       @db.Decimal(10, 2)
  priority        Int           @default(0)
  
  scope           DiscountScope @default(GLOBAL)
  targetIds       Int[]         
  
  rules           Json?         
  
  mode            DiscountMode  @default(AUTOMATIC)
  
  stackable       Boolean       @default(false)
  active          Boolean       @default(true)
  
  eventId         Int?
  event           Event?        @relation(fields: [eventId], references: [id])
  
  validFrom       DateTime?     @default(now())
  validUntil      DateTime?
}

// Configuración de Envíos por Zona
model ShippingZone {
  id          Int     @id @default(autoincrement())
  
  country     String? // Null = Todos
  province    String?
  city        String?
  
  cost        Decimal @db.Decimal(10, 2)
  
  active      Boolean @default(true)
  
  @@unique([country, province, city]) 
}

model StoreConfig {
  id              Int     @id @default(1) 
  
  // Identity
  storeName       String  @default("Mi Tienda")
  contactEmail    String?
  contactPhone    String?
  address         String?
  
  // Financial
  taxRate         Decimal @default(0) @db.Decimal(10, 2) 
  currencySymbol  String  @default("$")
  
  // Inventory
  lowStockThreshold Int   @default(5)
  criticalStockThreshold Int @default(2)
  preventStockout   Boolean @default(true) 
  
  // Toggles & Features
  enablePoints    Boolean @default(true)
  pointsPerCurrency Decimal @default(0.1) @db.Decimal(12, 4)
  
  enableShipping  Boolean @default(true)
  freeShippingThreshold Decimal? @db.Decimal(12, 4)
  webSafetyStock  Int @default(0) 

  enabledPaymentMethods Json?   
  
  enableEvents    Boolean @default(true) 
  
  enableBranches      Boolean @default(true)
  enableTransfers     Boolean @default(true) 
  enableStockMovements Boolean @default(true) 
  enableStockControl  Boolean @default(true)
  
  // Points Configuration
  enablePointsRedemption Boolean @default(false) 
  moneyPerPoint Decimal @default(1.0) @db.Decimal(12, 4) 
  
  // Socials
  socialInstagram String?
  socialFacebook  String?
  socialTwitter   String?
  
  maintenanceMode Boolean @default(false)

  // Backups
  enableAutoBackup Boolean @default(false)
  backupFrequency  String  @default("WEEKLY") // DAILY, WEEKLY, MONTHLY
  
  // Contenido Visual
  logoUrl         String?
  marqueeText     Json?     
  bannerImage     Json?     
  adImage         String?   
  adText          String?   
  secondaryAds    Json?     
  
  openingHours    Json?     

  customMeasurementUnits String[] @default([])
  
  // Multi-Currency
  baseCurrency       String  @default("ARS")
  defaultCurrency    String  @default("ARS")
  
  updatedAt       DateTime @updatedAt
}

model Currency {
  id                 Int            @id @default(autoincrement())
  code               String         @unique // ISO 4217: USD, ARS, EUR
  symbol             String
  exchangeRateToBase Decimal        @db.Decimal(18, 8) 
  isActive           Boolean        @default(true)
  
  productPrices      ProductPrice[]
  sales              Sale[]
  gatewaySupport     GatewayCurrencySupport[]
  saleReceipts       SaleReceipt[]
  purchases          Purchase[]
  supplierPayments   SupplierPayment[]
  
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model ProductPrice {
  id           Int      @id @default(autoincrement())
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code])
  price        Decimal  @db.Decimal(10, 2)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([productId, currencyCode])
}
// --------------------------------------------------------------------------
// PAYMENT GATEWAYS (Multi-Gateway System)
// --------------------------------------------------------------------------

model PaymentGateway {
  id               Int      @id @default(autoincrement())
  name             String   // "Mercado Pago", "Stripe", "PayPal"
  slug             String   @unique // "mercadopago", "stripe", "paypal"
  config           Json?    // public_key, access_token, secrets, etc.
  isActive         Boolean  @default(true)
  isGlobalFallback Boolean  @default(false)
  
  supportedCurrencies GatewayCurrencySupport[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model GatewayCurrencySupport {
  id           Int            @id @default(autoincrement())
  gatewayId    Int
  gateway      PaymentGateway @relation(fields: [gatewayId], references: [id], onDelete: Cascade)
  
  currencyCode String
  currency     Currency       @relation(fields: [currencyCode], references: [code])
  
  isPrimary    Boolean        @default(false) 
  
  @@unique([gatewayId, currencyCode])
}

// --------------------------------------------------------------------------
// STAGE 4: AUDITORIA Y LOGS
// --------------------------------------------------------------------------

model AuditLog {
  id          Int      @id @default(autoincrement())
  action      String   
  entityType  String   
  entityId    String   
  
  adminId     Int?
  admin       User?    @relation("AdminActions", fields: [adminId], references: [id])
  
  changes     Json?    
  ip          String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
}


model AccessLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  action      String   // "LOGIN", "LOGOUT", "FAILED_LOGIN"
  ip          String?
  userAgent   String?
  
  createdAt   DateTime @default(now())
}

// --------------------------------------------------------------------------
// TRANSFERENCIAS (MINI-APP)
// --------------------------------------------------------------------------

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
}

model Transfer {
  id          Int            @id @default(autoincrement())
  
  userId      Int
  user        User           @relation(fields: [userId], references: [id])
  
  amount      Decimal        @db.Decimal(10, 2)
  imageUrl    String
  
  status      TransferStatus @default(PENDING)
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  branchId    Int?
  branch      Branch?      @relation(fields: [branchId], references: [id])
}

// --------------------------------------------------------------------------
// MULTI-BRANCH SYSTEM
// --------------------------------------------------------------------------

model Branch {
  id              Int      @id @default(autoincrement())
  name            String
  code            String   @unique
  
  address         String
  city            String
  state           String
  country         String   @default("Argentina")
  postalCode      String?
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  
  phone           String
  email           String?
  whatsapp        String?
  
  facebook        String?
  instagram       String?
  twitter         String?
  
  operatingHours  Json
  
  isActive        Boolean  @default(true)
  isHeadquarters  Boolean  @default(false)
  
  administrators  UserBranch[]
  employees       User[]
  inventory       BranchInventory[]
  sales           Sale[]
  
  bankTransfers   Transfer[]
  
  transfersOut    StockTransfer[]     @relation("StockTransferOrigin")
  transfersIn     StockTransfer[]     @relation("StockTransferDestination")
  
  purchases       Purchase[]
  stockMovements  StockMovement[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Ticket sequencing
  lastTicketNumber Int     @default(0)
  receipts        SaleReceipt[]
}

model SaleReceipt {
  id              Int      @id @default(autoincrement())
  
  saleId          Int      @unique
  sale            Sale     @relation(fields: [saleId], references: [id])
  
  branchId        Int
  branch          Branch   @relation(fields: [branchId], references: [id])
  
  ticketNumber    String   
  subtotal        Decimal  @db.Decimal(10, 2)
  discount        Decimal  @db.Decimal(10, 2)
  total           Decimal  @db.Decimal(10, 2)
  
  currencyCode    String?  @default("ARS")
  currency        Currency? @relation(fields: [currencyCode], references: [code])
  
  paymentType     PaymentType
  
  status          String   @default("ISSUED") 
  
  issuedBy        Int?     
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([branchId, ticketNumber]) 
}

model BranchInventory {
  id              Int       @id @default(autoincrement())
  
  skuId           Int
  sku             SKU       @relation(fields: [skuId], references: [id], onDelete: Cascade)
  
  branchId        Int
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  stock           Decimal   @default(0) @db.Decimal(10, 3) 
  price           Decimal   @db.Decimal(10, 2)
  soldQuantity    Decimal   @default(0) @db.Decimal(10, 3)
  
  isActive        Boolean   @default(true)
  
  costPrice       Decimal?  @db.Decimal(10, 2)
  minStock        Decimal   @default(0) @db.Decimal(10, 3)
  maxStock        Decimal?  @db.Decimal(10, 3)
  
  reservations    StockReservation[]
  saleItems       SaleItem[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([skuId, branchId])
  @@index([branchId])
  @@index([skuId])
  @@index([branchId, isActive])
}

model UserBranch {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId     Int
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  assignedAt   DateTime  @default(now())
  assignedBy   Int?
  
  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

model StockTransfer {
  id                    Int            @id @default(autoincrement())
  
  originBranchId        Int
  originBranch          Branch         @relation("StockTransferOrigin", fields: [originBranchId], references: [id])
  
  destinationBranchId   Int
  destinationBranch     Branch         @relation("StockTransferDestination", fields: [destinationBranchId], references: [id])
  
  userId                Int
  user                  User           @relation(fields: [userId], references: [id])
  
  items                 StockTransferItem[]
  status                String         @default("PENDING") 
  notes                 String?        @db.Text
  
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  
  @@index([originBranchId])
  @@index([destinationBranchId])
  @@index([userId])
}

model StockTransferItem {
  id              Int           @id @default(autoincrement())
  
  transferId      Int
  transfer        StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  
  skuId           Int
  sku             SKU           @relation(fields: [skuId], references: [id])
  
  quantity        Decimal       @db.Decimal(10, 3)
}
// --------------------------------------------------------------------------
// PROVEEDORES (GLOBAL) - Stage 2
// --------------------------------------------------------------------------

model Supplier {
  id              Int      @id @default(autoincrement())
  
  tradeName       String
  legalName       String
  taxId           String   @unique
  taxStatus       String   
  
  email            String
  phone            String
  billingAddress   String
  
  isActive         Boolean  @default(true)
  
  // Relations
  skus             SupplierSKU[]
  purchases        Purchase[]
  payments         SupplierPayment[]
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// --------------------------------------------------------------------------
// PROVEEDOR <-> SKU (CATALOGO) - Stage 3
// --------------------------------------------------------------------------

model SupplierSKU {
  id                    Int      @id @default(autoincrement())
  
  supplierId            Int
  supplier              Supplier @relation(fields: [supplierId], references: [id])
  
  skuId                 Int
  sku                   SKU      @relation(fields: [skuId], references: [id])
  
  supplierSkuCode       String?  
  basePurchasePrice     Decimal  @db.Decimal(10, 2)
  currency              String   @default("ARS") 
  estimatedDeliveryDays  Int?    
  
  isActive              Boolean  @default(true)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@unique([supplierId, skuId])
}

// --------------------------------------------------------------------------
// COMPRAS (PURCHASE ORDERS) - Stage 4
// --------------------------------------------------------------------------

enum PurchaseStatus {
  DRAFT
  CONFIRMED
  RECEIVED
  CANCELLED
}

model Purchase {
  id              Int            @id @default(autoincrement())
  
  branchId        Int
  branch          Branch         @relation(fields: [branchId], references: [id])
  
  supplierId      Int
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  
  userId          Int            
  user            User           @relation(fields: [userId], references: [id])
  
  status          PurchaseStatus @default(DRAFT)
  
  estimatedTotal  Decimal        @default(0) @db.Decimal(10, 2)
  
  currencyCode           String?       @default("ARS") 
  currency               Currency?     @relation(fields: [currencyCode], references: [code])
  exchangeRateAtPurchase Decimal?      @default(1.0) @db.Decimal(18, 8)
  totalInBaseCurrency    Decimal?      @db.Decimal(10, 2)

  deliveryDate    DateTime?
  notes           String?        @db.Text
  
  items           PurchaseItem[]
  
  // Reception Audit
  receivedAt      DateTime?
  receivedBy      Int?           
  
  payment         SupplierPayment?
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model PurchaseItem {
  id              Int      @id @default(autoincrement())
  
  purchaseId      Int
  purchase        Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  
  skuId           Int
  sku             SKU      @relation(fields: [skuId], references: [id])
  
  quantity        Decimal  @db.Decimal(10, 3)
  unitPrice       Decimal  @db.Decimal(10, 2) 
  subtotal        Decimal  @db.Decimal(10, 2)
  
  receivedQuantity Int?    
  
  @@index([purchaseId])
  @@index([skuId])
}

// --------------------------------------------------------------------------
// MOVIMIENTOS DE STOCK (AUDITORIA) - Stage 5
// --------------------------------------------------------------------------

enum StockMovementType {
  PURCHASE           
  SALE               
  TRANSFER_IN        
  TRANSFER_OUT       
  MANUAL_ADJUSTMENT  
  RETURN             
}

model StockMovement {
  id              Int               @id @default(autoincrement())
  
  skuId           Int
  sku             SKU               @relation(fields: [skuId], references: [id])
  
  branchId        Int
  branch          Branch            @relation(fields: [branchId], references: [id])
  
  type            StockMovementType
  quantity        Decimal           @db.Decimal(10, 3) 
  
  resultingStock  Decimal           @db.Decimal(10, 3) 
  
  referenceId     String?           
  
  userId          Int?              
  notes           String?
  
  createdAt       DateTime          @default(now())
  
  @@index([skuId, branchId])
  @@index([type])
  @@index([createdAt])
}

// --------------------------------------------------------------------------
// PAGOS A PROVEEDORES (CONTABLE) - Stage 7
// --------------------------------------------------------------------------

enum SupplierPaymentMethod {
  CASH
  TRANSFER
  CHECK
  MERCADO_PAGO
  OTHER
}

model SupplierPayment {
  id              Int                   @id @default(autoincrement())
  
  supplierId      Int
  supplier        Supplier              @relation(fields: [supplierId], references: [id])
  
  purchaseId      Int?                  @unique 
  purchase        Purchase?             @relation(fields: [purchaseId], references: [id])
  
  amount          Decimal               @db.Decimal(10, 2)
  
  currencyCode           String?       @default("ARS") 
  currency               Currency?     @relation(fields: [currencyCode], references: [code])
  exchangeRateAtPurchase Decimal?      @default(1.0) @db.Decimal(18, 8)
  amountInBaseCurrency   Decimal?      @db.Decimal(10, 2)

  method          SupplierPaymentMethod
  paymentDate     DateTime
  
  reference       String?               
  
  createdBy       Int
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}
// --------------------------------------------------------------------------
// CHAT SYSTEM
// --------------------------------------------------------------------------

model ChatConversation {
  id        Int       @id @default(autoincrement())
  userId    Int?      
  user      User?     @relation(fields: [userId], references: [id])
  socketId  String?   
  closed    Boolean   @default(false)
  messages  ChatMessage[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ChatMessage {
  id             Int              @id @default(autoincrement())
  conversationId Int
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String           
  content        String
  read           Boolean          @default(false)
  createdAt      DateTime         @default(now())
}
model ChatAutoResponse {
  id        Int      @id @default(autoincrement())
  trigger   String?  @unique
  response  String?
  isActive  Boolean  @default(true)
}

// --------------------------------------------------------------------------
// SYSTEM / ERROR LOGS - Stage 8
// --------------------------------------------------------------------------

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ErrorStatus {
  OPEN
  RESOLVED
  IGNORED
}

model ErrorLog {
  id          Int           @id @default(autoincrement())
  severity    ErrorSeverity @default(MEDIUM)
  code        String        
  message     String
  stack       String?       @db.Text
  
  context     Json?         
  
  status      ErrorStatus   @default(OPEN)
  occurrences Int           @default(1) 
  
  resolvedBy  Int?          
  resolvedAt  DateTime?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

// --------------------------------------------------------------------------
// BLOG
// --------------------------------------------------------------------------
model BlogPost {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  excerpt      String
  content      String   @db.Text 
  coverImage   String?
  
  authorName   String   @default("Admin")
  authorAvatar String?
  authorBio    String?

  tags         String[] 
  readingTime  Int      @default(5) 
  
  published    Boolean  @default(false)
  publishedAt  DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published])
  @@index([publishedAt])
}
